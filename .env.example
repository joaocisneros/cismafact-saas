APP_NAME="Cisma Fact"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

# Token para /api/setup/* (migraciones y seeders por HTTP).
# Dejar VACIO en produccion: sin el, esas rutas responden 404.
SETUP_TOKEN=


APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_cisma_fact
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8090,127.0.0.1,127.0.0.1:8090
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=sunat_beta_
SANCTUM_VERIFY_IP=false
SANCTUM_LOG_USAGE=true
SANCTUM_MAX_INACTIVITY=120
SANCTUM_MAX_TOKENS=10
SANCTUM_ROTATE_TOKENS=false
SANCTUM_PURGE_DAYS=7

SUNAT_ENVIRONMENT=beta
SUNAT_CERTIFICATE_PATH=storage/app/public/certificado/certificado.pem
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_PRIVATE_KEY_PATH=

FILES_STORAGE_PATH=storage/app/sunat
FILES_MAX_SIZE=10240

VITE_APP_NAME="${APP_NAME}"

# Consultas de RUC y DNI. Ambas traen valor: solo se ponen para cambiar de
# proveedor o si el tuyo pide token.
CONSULTAS_URL=
CONSULTAS_TOKEN=

# Padrón SUNAT: cuánto sitio te da tu hosting, en GB. PHP no puede saberlo
# —lo que ve es el disco de la máquina, que en un hosting compartido es de
# todos—, así que si no se ponen, la pantalla dice que hay que comprobarlo en
# vez de dar por bueno un número que no es tuyo.
# El padrón pide unos 3 GB en la base de datos (6 si ya hay uno, porque
# durante el cambio conviven la tabla vieja y la nueva) y unos 400 MB en disco
# para el ZIP.
PADRON_CUOTA_DISCO_GB=
PADRON_CUOTA_BD_GB=
